# ─────────────────────────────────────────────────────────────
# J.A.R.V.I.S. Environment Configuration
# Copy to .env and fill in your values, or export these in your shell.
# ─────────────────────────────────────────────────────────────

# Voice settings
JARVIS_VOICE_INDEX=1                    # 0=male, 1=female (Windows sapi5)
JARVIS_SPEECH_RATE=200                  # words per minute
JARVIS_SPEECH_VOLUME=1.0                # 0.0 – 1.0

# Speech recognition
JARVIS_LISTEN_TIMEOUT=8                 # seconds to wait for speech start
JARVIS_PHRASE_TIME_LIMIT=5              # max recording length (seconds)

# Email (SMTP) — uses App Passwords (not your main Gmail password)
JARVIS_EMAIL_ADDRESS=your-email@gmail.com
JARVIS_EMAIL_PASSWORD=your-gmail-app-password
JARVIS_SMTP_SERVER=smtp.gmail.com
JARVIS_SMTP_PORT=587

# Weather (free tier at openweathermap.org)
JARVIS_WEATHER_API_KEY=your-openweather-api-key

# Media directories
JARVIS_MUSIC_DIR=/home/user/Music
JARVIS_VIDEO_DIR=/home/user/Videos

# Code editor path
JARVIS_CODE_EDITOR=/usr/bin/code

# Local LLM via Ollama (install from ollama.ai)
JARVIS_OLLAMA_MODEL=llama3
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
